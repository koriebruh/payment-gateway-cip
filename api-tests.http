### 1. Process a new Payment (Success Scenario)
# Expected outcome: 201 Created
POST {{host}}/payments
Authorization: Bearer {{jwt_token}}
Idempotency-Key: {{idempotent_key}}
Content-Type: application/json


{
  "order_id": "{{order_id}}",
  "amount": 9700.00,
  "currency": "IDR",
  "payment_method": "VIRTUAL_ACCOUNT",
  "channel": "MOBILE_BANKING"
}

### 2. Process Payment (Insufficient Balance - CoreBank Failure)
# Account starting with '99' triggers the mock CoreBankingClient failure.
# Expected outcome: 422 Unprocessable Entity with root FAILED status and "Insufficient balance" message

POST {{host}}/payments
Authorization: Bearer {{jwt_token}}
Idempotency-Key: {{idempotent_key}}
Content-Type: application/json

{
  "order_id": "99-fail-cfgfadnasiuqw2a",
  "amount": 99991.00,
  "currency": "IDR",
  "payment_method": "QRIS",
  "channel": "ATM"
}

### 3. Process Payment (Biller Failure)
# Payment method 'FAIL' triggers the mock BillerClient failure.
# Expected outcome: 502 Bad Gateway with root FAILED status and "Biller service unavailable" message
POST {{host}}/payments
Authorization: Bearer {{jwt_token}}
Idempotency-Key: {{$random.uuid}}
Content-Type: application/json

{
  "order_id": "biller-fail-{{$random.uuid}}",
  "amount": 75000.00,
  "currency": "IDR",
  "payment_method": "FAIL",
  "channel": "MOBILE_BANKING"
}

### 4. Process Payment (Duplicate Idempotency Key)
# Run this twice, BUT modify the payload (e.g., change amount or order_id) on the second run to trigger conflict.
# Expected outcome: 409 Conflict (Duplicate idempotency key used with different payload)
POST {{host}}/payments
Authorization: Bearer {{jwt_token}}
Idempotency-Key: static-idemp-12345
Content-Type: application/json

{
  "order_id": "static-order-12345",
  "amount": 10000.00,
  "currency": "IDR",
  "payment_method": "CREDIT_CARD",
  "channel": "INTERNET_BANKING"
}

### 5. Get Transaction Status
# Replace {order_id} with the ID of a previously created transaction.
# Expected outcome: 200 OK with current transaction status
GET {{host}}/payments/INV-9fa64940-37c9-4fb9-b7c4-120f0b800f02
Authorization: Bearer {{jwt_token}}
